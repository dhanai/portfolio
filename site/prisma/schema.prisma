generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Work {
  id             String   @id @default(cuid())
  slug           String   @unique
  sortOrder      Int      @default(0)
  published      Boolean  @default(true)
  title          String
  subtitle       String
  tags           String   // JSON string[]
  year           String
  color          String   @default("#FF453A")
  href           String?
  image          String?
  /** caseStudy | external | lightbox */
  cardAction     String   @default("caseStudy")
  lightboxImage  String?
  role           String
  externalUrl    String?
  diagram        String?
  reflection     String
  sections       String   // JSON CaseStudySection[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ContentBlock {
  key       String   @id
  data      String   // JSON
  updatedAt DateTime @updatedAt
}

/** Client-facing invoices — create/edit behind admin; public via /invoice/[token] */
model Invoice {
  id            String   @id @default(cuid())
  token         String   @unique
  number        String   @unique
  clientName    String
  clientEmail   String
  /** Legacy single-line fields (kept for older rows; prefer lineItems) */
  description   String   @default("")
  rateType      String   @default("fixed")
  rate          Float    @default(0)
  hours         Float?
  /** JSON InvoiceLineItem[] */
  lineItems     String   @default("[]")
  /** Cached total in dollars */
  amount        Float
  /** draft | sent | paid */
  status        String   @default("sent")
  /** Show W-9 download link on the client invoice */
  includeW9     Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/** Client-facing proposals — create/edit behind admin; public via /proposal/[token] */
model Proposal {
  id               String   @id @default(cuid())
  token            String   @unique
  number           String   @unique
  clientName       String
  clientCompany    String   @default("")
  clientEmail      String
  title            String
  goals            String?
  /** JSON string[] */
  deliverables     String   @default("[]")
  timeframe        String   @default("")
  quoteLabel       String   @default("")
  amount           Float
  paymentSchedule  String   @default("")
  /** JSON string[] */
  nextSteps        String   @default("[]")
  terms            String   @default("")
  notes            String?
  /** sent | accepted | declined */
  status           String   @default("sent")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
